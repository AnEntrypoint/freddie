{
  "name": "@freddie/freddie-session-reference",
  "description": "Cross-session snapshot references and durable untrusted model context (ctx.sessionReferenceResolver)",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/context/session-reference"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./types": {
      "default": "./src/types.js"
    },
    "./typert": {
      "default": "./src/typert.host.js"
    },
    "./remote": {
      "default": "./src/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/config.js",
    "src/index.js",
    "src/invariant.js",
    "src/projection.js",
    "src/serialization.js",
    "src/types.js",
    "src/uri.js",
    "src/typert.host.js",
    "src/typert.remote-client.js"
  ],
  "license": "MIT",
  "dependencies": {
    "@freddie/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@freddie/freddie-agent": "workspace:^",
    "@freddie/freddie-compaction": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/freddie-llm": "workspace:^",
    "@freddie/freddie-output-retention": "workspace:^",
    "@freddie/freddie-session": "workspace:^",
    "@freddie/freddie-session-query": "workspace:^",
    "@freddie/freddie-typert-protocol": "workspace:^",
    "@freddie/cordis": "workspace:^"
  },
  "devDependencies": {
    "@freddie/freddie-agent": "workspace:^",
    "@freddie/freddie-compaction": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/freddie-llm": "workspace:^",
    "@freddie/freddie-output-retention": "workspace:^",
    "@freddie/freddie-session": "workspace:^",
    "@freddie/freddie-session-query": "workspace:^",
    "@freddie/freddie-typert-protocol": "workspace:^",
    "@freddie/cordis": "workspace:^"
  }
}
