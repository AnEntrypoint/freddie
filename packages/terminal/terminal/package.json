{
  "name": "@freddie/freddie-terminal",
  "description": "Persistent PTY session seam for the Freddie — owner-scoped ids, backend registry, interactive sends, reads, signals, and awaited cleanup",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/terminal/terminal"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.js",
    "src/invariant.js",
    "src/types.js"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@freddie/freddie-agent": "workspace:^",
    "@freddie/freddie-brand": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/cordis": "workspace:^"
  },
  "devDependencies": {
    "@freddie/freddie-agent": "workspace:^",
    "@freddie/freddie-brand": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/freddie-session": "workspace:^",
    "@freddie/cordis": "workspace:^"
  }
}
