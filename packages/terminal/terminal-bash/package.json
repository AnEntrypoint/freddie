{
  "name": "@freddie/freddie-terminal-bash",
  "description": "Persistent shell PTY backend over the Freddie subprocess terminal primitive",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/terminal/terminal-bash"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.js",
    "src/invariant.js",
    "src/config.js",
    "src/sanitize.js",
    "src/session.js"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@freddie/freddie-agent": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-terminal": "*",
    "@freddie/freddie-sandbox": "*",
    "@freddie/freddie-sandbox-policy": "*",
    "@freddie/freddie-session": "*",
    "@freddie/freddie-subprocess": "*",
    "@freddie/cordis": "*"
  },
  "dependencies": {
    "@freddie/freddie-pwsh-local": "*",
    "@freddie/schemastery": "*"
  },
  "devDependencies": {
    "@freddie/freddie-agent": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-terminal": "*",
    "@freddie/freddie-sandbox": "*",
    "@freddie/freddie-sandbox-policy": "*",
    "@freddie/freddie-session": "*",
    "@freddie/freddie-subprocess": "*",
    "@freddie/freddie-subprocess-local": "*",
    "@freddie/cordis": "*"
  }
}
