{
  "name": "@freddie/freddie-terminal-bash",
  "description": "Persistent shell PTY backend over the Freddie subprocess terminal primitive",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/terminal/terminal-bash"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.js",
    "src/invariant.js",
    "src/config.js",
    "src/sanitize.js",
    "src/session.js"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@freddie/freddie-agent": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/freddie-terminal": "workspace:^",
    "@freddie/freddie-sandbox": "workspace:^",
    "@freddie/freddie-sandbox-policy": "workspace:^",
    "@freddie/freddie-session": "workspace:^",
    "@freddie/freddie-subprocess": "workspace:^",
    "@freddie/cordis": "workspace:^"
  },
  "dependencies": {
    "@freddie/freddie-pwsh-local": "workspace:^",
    "@freddie/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@freddie/freddie-agent": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/freddie-terminal": "workspace:^",
    "@freddie/freddie-sandbox": "workspace:^",
    "@freddie/freddie-sandbox-policy": "workspace:^",
    "@freddie/freddie-session": "workspace:^",
    "@freddie/freddie-subprocess": "workspace:^",
    "@freddie/freddie-subprocess-local": "workspace:^",
    "@freddie/cordis": "workspace:^"
  }
}
