{
  "name": "@freddie/freddie-credentials-local",
  "description": "File-backed credentials provider ($FREDDIE_HOME/.env under the live process environment) for the Freddie",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/credentials/credentials-local"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.js",
    "src/invariant.js"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@freddie/freddie-atomic-write": "*",
    "@freddie/freddie-credentials": "*",
    "@freddie/freddie-launch-environment": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-home-paths": "*",
    "@freddie/cordis": "*"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "@freddie/schemastery": "*",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@freddie/freddie-atomic-write": "*",
    "@freddie/freddie-credentials": "*",
    "@freddie/freddie-launch-environment": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-home-paths": "*",
    "@freddie/cordis": "*"
  }
}
