{
  "name": "@freddie/freddie-mcp-client",
  "description": "MCP client bridge: connects to MCP servers and registers their tools on ctx.tools",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/mcp/mcp-client"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/*.js"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@freddie/freddie-attachment": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/freddie-llm": "workspace:^",
    "@freddie/freddie-subprocess": "workspace:^",
    "@freddie/freddie-timeout": "workspace:^",
    "@freddie/freddie-tools": "workspace:^",
    "@freddie/cordis": "workspace:^"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@freddie/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@freddie/freddie-attachment": "workspace:^",
    "@freddie/freddie-attachment-local": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/freddie-llm": "workspace:^",
    "@freddie/freddie-subprocess": "workspace:^",
    "@freddie/freddie-timeout": "workspace:^",
    "@freddie/freddie-tools": "workspace:^",
    "@freddie/cordis": "workspace:^"
  }
}
