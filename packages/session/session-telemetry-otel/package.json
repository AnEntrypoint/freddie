{
  "name": "@freddie/freddie-session-telemetry-otel",
  "description": "OpenTelemetry backend for the Freddie telemetry seam: hands captured session records to the OTel JS SDK's log pipeline",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/session/session-telemetry-otel"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/*.js"
  ],
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.220.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-logs": "^0.220.0",
    "@freddie/schemastery": "*"
  },
  "peerDependencies": {
    "@freddie/freddie-command-feedback": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-llm": "*",
    "@freddie/freddie-session": "*",
    "@freddie/freddie-session-telemetry": "*",
    "@freddie/freddie-anonymous-user-id": "*",
    "@freddie/cordis": "*"
  },
  "devDependencies": {
    "@freddie/cordis-plugin-loader": "*",
    "@freddie/freddie-command-feedback": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-llm": "*",
    "@freddie/freddie-session": "*",
    "@freddie/freddie-session-telemetry": "*",
    "@freddie/freddie-anonymous-user-id": "*",
    "@freddie/cordis": "*"
  }
}
