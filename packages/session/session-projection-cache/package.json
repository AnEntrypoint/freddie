    "directory": "packages/session/session-projection-cache"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.js",
    "src/invariant.js",
    "src/spec.js"
  ],
  "license": "MIT",
  "dependencies": {
    "@freddie/schemastery": "workspace:^"
  },
