    "@freddie/freddie-session-persistence": "workspace:^",
    "@freddie/freddie-session-projection": "workspace:^",
    "@freddie/freddie-storage-domain": "workspace:^",
    "@freddie/cordis": "workspace:^"
  },
  "devDependencies": {
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/freddie-session": "workspace:^",
    "@freddie/freddie-session-persistence": "workspace:^",
    "@freddie/freddie-session-projection": "workspace:^",
    "@freddie/freddie-storage": "workspace:^",
    "@freddie/freddie-storage-domain": "workspace:^",
    "@freddie/cordis": "workspace:^"
  }
}
