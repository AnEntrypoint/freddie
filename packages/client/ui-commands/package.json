{
  "name": "@freddie/freddie-client-ui-commands",
  "description": "Client command surface: global directory cache, '/' source, three command UI kinds, popupSelect registry",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/client/ui-commands"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./client": {
      "default": "./src/client/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "freddie": {
    "client": {
      "inject": [
        "@freddie/freddie-api-remotes",
        "@freddie/freddie-client-runtime",
        "@freddie/freddie-client-locale",
        "@freddie/freddie-client-ui-input-trigger",
        "@freddie/freddie-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "@freddie/webjsx": "*"
  },
  "peerDependencies": {
    "@freddie/freddie-api-remotes": "*",
    "@freddie/freddie-client-locale": "*",
    "@freddie/freddie-client-runtime": "*",
    "@freddie/freddie-client-ui-conversation": "*",
    "@freddie/freddie-client-ui-input-trigger": "*",
    "@freddie/freddie-commands": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/cordis": "*"
  },
  "devDependencies": {
    "@freddie/freddie-api-remotes": "*",
    "@freddie/freddie-client-connection": "*",
    "@freddie/freddie-client-locale": "*",
    "@freddie/freddie-client-runtime": "*",
    "@freddie/freddie-client-ui-conversation": "*",
    "@freddie/freddie-client-ui-primitives": "*",
    "@freddie/freddie-client-ui-input-trigger": "*",
    "@freddie/freddie-client-ui-slots": "*",
    "@freddie/freddie-commands": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/cordis": "*"
  },
  "files": [
    "src/**/*.js"
  ]
}
