{
  "name": "@freddie/freddie-client-ui-conversation",
  "description": "Conversation domain: skeleton, ordered chat flow, composer with the Host-backed busy-Enter preference, and details host",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/client/ui-conversation"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./client": {
      "default": "./src/client/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "freddie": {
    "client": {
      "inject": [
        "@freddie/freddie-client-connection",
        "@freddie/freddie-client-locale",
        "@freddie/freddie-client-runtime",
        "@freddie/freddie-client-ui-settings",
        "@freddie/freddie-api-remotes",
        "@freddie/freddie-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "@freddie/webjsx": "*",
    "@freddie/schemastery": "*"
  },
  "peerDependencies": {
    "@freddie/cordis": "*",
    "@freddie/freddie-agent": "*",
    "@freddie/freddie-api-remotes": "*",
    "@freddie/freddie-attachment": "*",
    "@freddie/freddie-brand": "*",
    "@freddie/freddie-client-connection": "*",
    "@freddie/freddie-client-locale": "*",
    "@freddie/freddie-client-runtime": "*",
    "@freddie/freddie-client-ui-settings": "*",
    "@freddie/freddie-client-ui-input-trigger": "*",
    "@freddie/freddie-commands": "*",
    "@freddie/freddie-compaction": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-llm-retry": "*",
    "@freddie/freddie-session-stats": "*",
    "@freddie/freddie-token-meter": "*",
    "@freddie/freddie-tools": "*",
    "@freddie/freddie-settings": "*",
    "@freddie/freddie-client-ui-layout": "*",
    "@freddie/freddie-goal": "*",
    "@freddie/freddie-permission-presets": "*",
    "@freddie/freddie-plan-mode": "*",
    "@freddie/freddie-tool-todo": "*"
  },
  "devDependencies": {
    "@freddie/cordis": "*",
    "@freddie/freddie-agent": "*",
    "@freddie/freddie-api-remotes": "*",
    "@freddie/freddie-attachment": "*",
    "@freddie/freddie-brand": "*",
    "@freddie/freddie-client-connection": "*",
    "@freddie/freddie-client-locale": "*",
    "@freddie/freddie-client-runtime": "*",
    "@freddie/freddie-client-ui-layout": "*",
    "@freddie/freddie-client-ui-primitives": "*",
    "@freddie/freddie-client-ui-settings": "*",
    "@freddie/freddie-client-ui-input-trigger": "*",
    "@freddie/freddie-client-ui-slots": "*",
    "@freddie/freddie-commands": "*",
    "@freddie/freddie-compaction": "*",
    "@freddie/freddie-goal": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-llm-retry": "*",
    "@freddie/freddie-permission-presets": "*",
    "@freddie/freddie-plan-mode": "*",
    "@freddie/freddie-session-projection": "*",
    "@freddie/freddie-session-stats": "*",
    "@freddie/freddie-token-meter": "*",
    "@freddie/freddie-tool-todo": "*",
    "@freddie/freddie-tools": "*",
    "@freddie/freddie-settings": "*"
  },
  "files": [
    "src/**/*.js"
  ]
}
