{
  "name": "@freddie/freddie-client-ui-observability",
  "description": "Graph-first Overview of the live GM PRD/mutable walk, with node inspect and edit",
  "version": "0.1.1-rc.2",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/client/ui-observability"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": { "default": "./src/index.js" },
    "./invariant": { "default": "./src/invariant.js" },
    "./client": { "default": "./src/client/index.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "freddie": {
    "client": {
      "inject": [
        "@freddie/freddie-client-connection",
        "@freddie/freddie-client-runtime",
        "@freddie/freddie-client-locale",
        "@freddie/freddie-client-ui-conversation",
        "@freddie/freddie-api-remotes"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "dependencies": { "@freddie/webjsx": "*" },
  "peerDependencies": {
    "@freddie/cordis": "*",
    "@freddie/freddie-api-remotes": "*",
    "@freddie/freddie-client-connection": "*",
    "@freddie/freddie-client-locale": "*",
    "@freddie/freddie-client-runtime": "*",
    "@freddie/freddie-client-ui-conversation": "*",
    "@freddie/freddie-invariants": "*"
  },
  "devDependencies": {
    "@freddie/cordis": "*",
    "@freddie/freddie-api-remotes": "*",
    "@freddie/freddie-client-connection": "*",
    "@freddie/freddie-client-locale": "*",
    "@freddie/freddie-client-runtime": "*",
    "@freddie/freddie-client-ui-conversation": "*",
    "@freddie/freddie-client-ui-primitives": "*",
    "@freddie/freddie-client-ui-slots": "*",
    "@freddie/freddie-invariants": "*"
  },
  "files": ["src/**/*.js"]
}
