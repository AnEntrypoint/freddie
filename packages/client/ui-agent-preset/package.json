{
  "name": "@freddie/freddie-client-ui-agent-preset",
  "description": "Agent-preset surfaces: the default for later sessions, this session's seat, and the composition editor",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/client/ui-agent-preset"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./client": {
      "default": "./src/client/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "freddie": {
    "client": {
      "inject": [
        "@freddie/freddie-client-connection",
        "@freddie/freddie-client-locale",
        "@freddie/freddie-client-runtime",
        "@freddie/freddie-client-ui-conversation",
        "@freddie/freddie-client-ui-settings",
        "@freddie/freddie-api-remotes"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@freddie/cordis": "workspace:^",
    "@freddie/freddie-api-remotes": "workspace:^",
    "@freddie/freddie-client-connection": "workspace:^",
    "@freddie/freddie-client-locale": "workspace:^",
    "@freddie/freddie-client-runtime": "workspace:^",
    "@freddie/freddie-client-ui-conversation": "workspace:^",
    "@freddie/freddie-client-ui-settings": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^"
  },
  "dependencies": {
    "webjsx": "^0.0.73"
  },
  "devDependencies": {
    "@freddie/freddie-api-remotes": "workspace:^",
    "@freddie/freddie-client-connection": "workspace:^",
    "@freddie/freddie-client-locale": "workspace:^",
    "@freddie/freddie-client-runtime": "workspace:^",
    "@freddie/freddie-client-ui-conversation": "workspace:^",
    "@freddie/freddie-client-ui-primitives": "workspace:^",
    "@freddie/freddie-client-ui-settings": "workspace:^",
    "@freddie/freddie-client-ui-slots": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/cordis": "workspace:^"
  },
  "files": [
    "src/index.js",
    "src/invariant.js",
    "src/client/*.js"
  ]
}
