{
  "name": "@freddie/freddie-client-file-upload",
  "description": "Session-addressed browser file uploads with streaming intake, progress, cancellation, and staged receipts for later prompts",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/client/file-upload"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./client": {
      "default": "./src/client/index.js"
    },
    "./shared": {
      "default": "./src/shared.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "freddie": {
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@freddie/schemastery": "*"
  },
  "peerDependencies": {
    "@freddie/cordis": "*",
    "@freddie/freddie-client-connection": "*",
    "@freddie/freddie-home-paths": "*",
    "@freddie/freddie-host-webserver": "*",
    "@freddie/freddie-invariants": "*"
  },
  "devDependencies": {
    "@freddie/cordis": "*",
    "@freddie/freddie-client-connection": "*",
    "@freddie/freddie-home-paths": "*",
    "@freddie/freddie-host-webserver": "*",
    "@freddie/freddie-invariants": "*"
  },
  "files": [
    "src/index.js",
    "src/invariant.js",
    "src/shared.js",
    "src/error.js",
    "src/staging.js",
    "src/intake.js",
    "src/media-type.js",
    "src/http-route.js",
    "src/client/index.js",
    "src/client/runtime.js",
    "src/client/worker.js",
    "src/client/progress.js"
  ]
}
