{
  "name": "@freddie/freddie-client-ui-message-feedback",
  "description": "Per-message feedback controls contributed to the assistant-message action strip, backed by the messageFeedback Host Remote",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/client/ui-message-feedback"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./client": {
      "default": "./src/client/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "freddie": {
    "client": {
      "inject": [
        "@freddie/freddie-client-runtime",
        "@freddie/freddie-api-remotes",
        "@freddie/freddie-client-locale",
        "@freddie/freddie-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@freddie/freddie-api-remotes": "*",
    "@freddie/freddie-client-connection": "*",
    "@freddie/freddie-client-locale": "*",
    "@freddie/freddie-client-runtime": "*",
    "@freddie/freddie-client-ui-conversation": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-message-feedback": "*",
    "@freddie/freddie-typert-protocol": "*",
    "@freddie/cordis": "*"
  },
  "devDependencies": {
    "@freddie/freddie-api-remotes": "*",
    "@freddie/freddie-client-connection": "*",
    "@freddie/freddie-client-locale": "*",
    "@freddie/freddie-client-runtime": "*",
    "@freddie/freddie-client-ui-conversation": "*",
    "@freddie/freddie-client-ui-primitives": "*",
    "@freddie/freddie-client-ui-slots": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-message-feedback": "*",
    "@freddie/freddie-typert-protocol": "*",
    "@freddie/cordis": "*"
  },
  "dependencies": {
    "@freddie/webjsx": "*"
  },
  "files": [
    "src/index.js",
    "src/invariant.js",
    "src/client/index.js",
    "src/client/controller.js",
    "src/client/locales.js",
    "src/client/MessageFeedbackActions.js",
    "src/client/MessageFeedbackActions.css.js"
  ]
}
