{
  "name": "@freddie/freddie-client-runtime",
  "description": "Client core services: SlotRegistry, SessionRuntime (scope tree + object layer)",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/client/runtime"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./client": {
      "default": "./src/client/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "freddie": {
    "client": {
      "inject": [
        "@freddie/freddie-client-connection",
        "@freddie/freddie-typert-registry",
        "@freddie/freddie-api-remotes"
      ],
      "platform": "web",
      "immediately": true,
      "external": [
        "@freddie/freddie-session/surface",
        "@freddie/freddie-host-apiproxy/api",
        "@freddie/freddie-llm/message"
      ]
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@freddie/cordis": "workspace:^",
    "@freddie/freddie-api-remotes": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/freddie-typert-protocol": "workspace:^",
    "@freddie/freddie-typert-registry": "workspace:^",
    "@freddie/freddie-agent": "workspace:^",
    "@freddie/freddie-attachment": "workspace:^",
    "@freddie/freddie-client-connection": "workspace:^",
    "@freddie/freddie-commands": "workspace:^",
    "@freddie/freddie-host-apiproxy": "workspace:^",
    "@freddie/freddie-llm": "workspace:^",
    "@freddie/freddie-llm-retry": "workspace:^",
    "@freddie/freddie-session": "workspace:^",
    "@freddie/freddie-session-projection": "workspace:^",
    "@freddie/freddie-session-title": "workspace:^",
    "@freddie/freddie-tools": "workspace:^"
  },
  "devDependencies": {
    "@freddie/cordis": "workspace:^",
    "@freddie/freddie-api-remotes": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/freddie-timeout": "workspace:^",
    "@freddie/freddie-typert-protocol": "workspace:^",
    "@freddie/freddie-typert-registry": "workspace:^",
    "@freddie/freddie-client-ui-slots": "workspace:^",
    "@freddie/freddie-agent": "workspace:^",
    "@freddie/freddie-attachment": "workspace:^",
    "@freddie/freddie-client-connection": "workspace:^",
    "@freddie/freddie-commands": "workspace:^",
    "@freddie/freddie-host-apiproxy": "workspace:^",
    "@freddie/freddie-llm": "workspace:^",
    "@freddie/freddie-llm-retry": "workspace:^",
    "@freddie/freddie-session": "workspace:^",
    "@freddie/freddie-session-projection": "workspace:^",
    "@freddie/freddie-session-title": "workspace:^",
    "@freddie/freddie-tools": "workspace:^"
  },
  "files": [
    "src/**/*.js"
  ]
}
