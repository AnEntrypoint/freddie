{
  "name": "@freddie/freddie-client-ui-jobs",
  "description": "Session-header background-job list: live registry state mirrored from session/jobs frames",
  "version": "0.1.1-rc.2",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./client": {
      "default": "./src/client/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "freddie": {
    "client": {
      "inject": [
        "@freddie/freddie-client-locale",
        "@freddie/freddie-client-runtime",
        "@freddie/freddie-client-ui-conversation",
        "@freddie/freddie-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/client/ui-jobs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@freddie/webjsx": "*"
  },
  "peerDependencies": {
    "@freddie/freddie-client-locale": "*",
    "@freddie/freddie-client-runtime": "*",
    "@freddie/freddie-client-ui-conversation": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/cordis": "*"
  },
  "devDependencies": {
    "@freddie/freddie-client-locale": "*",
    "@freddie/freddie-client-runtime": "*",
    "@freddie/freddie-client-ui-conversation": "*",
    "@freddie/freddie-client-ui-primitives": "*",
    "@freddie/freddie-client-ui-slots": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/cordis": "*"
  },
  "files": [
    "src/index.js",
    "src/invariant.js",
    "src/client/index.js",
    "src/client/JobListAction.js",
    "src/client/JobListAction.css.js",
    "src/client/locales.js"
  ]
}
