{
  "name": "@freddie/freddie-client-ui-settings-plugin-inventory",
  "description": "Read-only Cordis Loader inventory tab in Web Plugins settings",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/client/ui-settings-plugin-inventory"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./client": {
      "default": "./src/client/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "freddie": {
    "client": {
      "inject": [
        "@freddie/freddie-api-remotes",
        "@freddie/freddie-client-runtime",
        "@freddie/freddie-client-ui-settings",
        "@freddie/freddie-client-locale"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@freddie/freddie-api-remotes": "*",
    "@freddie/freddie-client-locale": "*",
    "@freddie/freddie-client-runtime": "*",
    "@freddie/freddie-client-ui-settings": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/cordis": "*"
  },
  "devDependencies": {
    "@freddie/freddie-api-remotes": "*",
    "@freddie/freddie-client-locale": "*",
    "@freddie/freddie-client-runtime": "*",
    "@freddie/freddie-client-ui-primitives": "*",
    "@freddie/freddie-client-ui-settings": "*",
    "@freddie/freddie-client-ui-slots": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/cordis": "*"
  },
  "dependencies": {
    "@freddie/webjsx": "*"
  },
  "files": [
    "src/index.js",
    "src/invariant.js",
    "src/client/index.js",
    "src/client/locales.js",
    "src/client/PluginInventorySettingsTab.js",
    "src/client/PluginInventorySettingsTab.css.js"
  ]
}
