{
  "name": "@freddie/freddie-client-ui-tool",
  "description": "Client Tool call-tree renderer and keyed per-tool presentation slot",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/client/ui-tool"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./client": {
      "default": "./src/client/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "freddie": {
    "client": {
      "inject": [
        "@freddie/freddie-client-connection",
        "@freddie/freddie-client-runtime",
        "@freddie/freddie-client-locale",
        "@freddie/freddie-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "@freddie/webjsx": "*"
  },
  "peerDependencies": {
    "@freddie/cordis": "*",
    "@freddie/freddie-api-remotes": "*",
    "@freddie/freddie-client-connection": "*",
    "@freddie/freddie-client-locale": "*",
    "@freddie/freddie-client-runtime": "*",
    "@freddie/freddie-client-ui-conversation": "*",
    "@freddie/freddie-invariants": "*"
  },
  "devDependencies": {
    "@freddie/cordis": "*",
    "@freddie/freddie-api-remotes": "*",
    "@freddie/freddie-client-connection": "*",
    "@freddie/freddie-client-locale": "*",
    "@freddie/freddie-client-runtime": "*",
    "@freddie/freddie-client-ui-conversation": "*",
    "@freddie/freddie-client-ui-primitives": "*",
    "@freddie/freddie-client-ui-slots": "*",
    "@freddie/freddie-invariants": "*"
  },
  "files": [
    "src/**/*.js"
  ]
}
