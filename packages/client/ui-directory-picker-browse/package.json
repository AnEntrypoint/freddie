{
  "name": "@freddie/freddie-client-ui-directory-picker-browse",
  "description": "In-app directory browsing surface: the workspace directory-flow owner rendering the host's listing and creation primitives",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/client/ui-directory-picker-browse"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./client": {
      "default": "./src/client/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "freddie": {
    "client": {
      "inject": [
        "@freddie/freddie-client-runtime",
        "@freddie/freddie-client-ui-workspace",
        "@freddie/freddie-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "webjsx": "^0.0.73"
  },
  "peerDependencies": {
    "@freddie/freddie-client-locale": "workspace:^",
    "@freddie/freddie-client-runtime": "workspace:^",
    "@freddie/freddie-client-ui-workspace": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/cordis": "workspace:^"
  },
  "devDependencies": {
    "@freddie/freddie-client-locale": "workspace:^",
    "@freddie/freddie-client-runtime": "workspace:^",
    "@freddie/freddie-client-ui-primitives": "workspace:^",
    "@freddie/freddie-client-ui-slots": "workspace:^",
    "@freddie/freddie-client-ui-workspace": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/cordis": "workspace:^"
  },
  "files": [
    "src/index.js",
    "src/invariant.js",
    "src/client/index.js",
    "src/client/flow.js",
    "src/client/DirectoryBrowser.js",
    "src/client/DirectoryBrowser.css",
    "src/client/DirectoryBrowser.css.js"
  ]
}
