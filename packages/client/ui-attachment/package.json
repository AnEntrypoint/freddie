{
  "name": "@freddie/freddie-client-ui-attachment",
  "description": "Dynamic attachment presentation plugin for conversation input and message-image slots",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/client/ui-attachment"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./client": {
      "default": "./src/client/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "freddie": {
    "client": {
      "inject": [
        "@freddie/freddie-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "@freddie/webjsx": "*"
  },
  "devDependencies": {
    "@freddie/cordis": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-client-runtime": "*",
    "@freddie/freddie-client-ui-conversation": "*",
    "@freddie/freddie-client-ui-primitives": "*",
    "@freddie/freddie-client-ui-slots": "*",
    "@freddie/freddie-attachment": "*"
  },
  "files": [
    "src/index.js",
    "src/invariant.js",
    "src/AttachmentRail.js",
    "src/AttachmentRail.css.js",
    "src/DropOverlay.js",
    "src/DropOverlay.css.js",
    "src/ImageLightbox.js",
    "src/ImageLightbox.css.js",
    "src/MessageImage.js",
    "src/MessageImage.css.js",
    "src/client/index.js",
    "src/client/labels.js",
    "src/client/MessageImages.js",
    "src/client/ComposerAttachments.js",
    "src/client/ComposerAttachments.css.js"
  ],
  "peerDependencies": {
    "@freddie/cordis": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-client-runtime": "*",
    "@freddie/freddie-client-ui-conversation": "*",
    "@freddie/freddie-attachment": "*"
  }
}
