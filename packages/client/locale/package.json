{
  "name": "@freddie/freddie-client-locale",
  "description": "Locale plugin: Host-backed zh/en preference, browser-derived fallback, locale snapshots, and typed namespace dictionaries",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/client/locale"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./client": {
      "default": "./src/client/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "freddie": {
    "client": {
      "inject": [
        "@freddie/freddie-client-connection",
        "@freddie/freddie-client-runtime",
        "@freddie/freddie-client-ui-settings",
        "@freddie/freddie-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@freddie/cordis": "workspace:^",
    "@freddie/freddie-api-remotes": "workspace:^",
    "@freddie/freddie-client-connection": "workspace:^",
    "@freddie/freddie-client-runtime": "workspace:^",
    "@freddie/freddie-client-ui-settings": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/freddie-settings": "workspace:^"
  },
  "devDependencies": {
    "@freddie/cordis": "workspace:^",
    "@freddie/freddie-api-remotes": "workspace:^",
    "@freddie/freddie-client-runtime": "workspace:^",
    "@freddie/freddie-client-ui-primitives": "workspace:^",
    "@freddie/freddie-client-ui-settings": "workspace:^",
    "@freddie/freddie-client-ui-slots": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/freddie-client-connection": "workspace:^",
    "@freddie/freddie-settings": "workspace:^"
  },
  "dependencies": {
    "@freddie/schemastery": "workspace:^",
    "webjsx": "^0.0.73"
  },
  "files": [
    "src/index.js",
    "src/invariant.js",
    "src/locale-settings.js",
    "src/locales/en.js",
    "src/locales/index.js",
    "src/locales/settings.js",
    "src/locales/zh.js",
    "src/client/index.js",
    "src/client/LanguageRow.js",
    "src/client/LanguageRow.css.js",
    "src/client/settings-store.js"
  ]
}
