{
  "name": "@freddie/freddie-client-ui-settings-subagent",
  "description": "Subagent settings card on the Plugins page: delegation depth and parallel capacity over the `subagent` namespace",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/client/ui-settings-subagent"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./client": {
      "default": "./src/client/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "freddie": {
    "client": {
      "inject": [
        "@freddie/freddie-client-locale",
        "@freddie/freddie-client-runtime",
        "@freddie/freddie-client-ui-settings",
        "@freddie/freddie-client-ui-settings-plugins"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@freddie/cordis": "*",
    "@freddie/freddie-client-locale": "*",
    "@freddie/freddie-client-runtime": "*",
    "@freddie/freddie-client-ui-settings": "*",
    "@freddie/freddie-client-ui-settings-plugins": "*",
    "@freddie/freddie-settings": "*"
  },
  "devDependencies": {
    "@freddie/cordis": "*",
    "@freddie/freddie-client-locale": "*",
    "@freddie/freddie-client-runtime": "*",
    "@freddie/freddie-client-ui-primitives": "*",
    "@freddie/freddie-client-ui-settings": "*",
    "@freddie/freddie-client-ui-settings-plugins": "*",
    "@freddie/freddie-client-ui-slots": "*",
    "@freddie/freddie-settings": "*"
  },
  "files": [
    "src/index.js",
    "src/client/index.js",
    "src/client/SubagentCard.js",
    "src/client/locales.js",
    "src/client/subagent-card-controller.js"
  ],
  "dependencies": {
    "@freddie/webjsx": "*",
    "@freddie/schemastery": "*"
  }
}
