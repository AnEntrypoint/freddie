{
  "name": "@freddie/freddie-client-ui-input-trigger",
  "description": "Input trigger pipeline: '/' and '@' detection, candidate menu, pick routing to registered sources",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/client/ui-input-trigger"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./client": {
      "default": "./src/client/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "freddie": {
    "client": {
      "inject": [
        "@freddie/freddie-client-runtime",
        "@freddie/freddie-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "webjsx": "^0.0.73"
  },
  "peerDependencies": {
    "@freddie/freddie-client-locale": "workspace:^",
    "@freddie/freddie-client-runtime": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/cordis": "workspace:^",
    "@freddie/freddie-file-reference": "workspace:^"
  },
  "devDependencies": {
    "@freddie/freddie-client-locale": "workspace:^",
    "@freddie/freddie-client-runtime": "workspace:^",
    "@freddie/freddie-client-ui-primitives": "workspace:^",
    "@freddie/freddie-client-ui-slots": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/cordis": "workspace:^",
    "@freddie/freddie-file-reference": "workspace:^"
  },
  "files": [
    "src/index.js",
    "src/invariant.js",
    "src/client/index.js",
    "src/client/service.js",
    "src/client/controller.js",
    "src/client/contract.js",
    "src/client/slots.js",
    "src/client/locales.js",
    "src/client/MenuView.js",
    "src/client/MenuView.css",
    "src/client/MenuView.css.js",
    "src/core/contract.js",
    "src/core/detect.js",
    "src/core/menu.js",
    "src/types.js"
  ]
}
