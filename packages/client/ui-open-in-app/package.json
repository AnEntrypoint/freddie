{
  "name": "@freddie/freddie-client-ui-open-in-app",
  "description": "Session-header split button opening the workspace directory in an installed application: freddie web",
  "version": "0.1.1-rc.2",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/lanmower/freddie.git", "directory": "packages/client/ui-open-in-app" },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": { "default": "./src/index.js" },
    "./invariant": { "default": "./src/invariant.js" },
    "./client": { "default": "./src/client/index.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "freddie": {
    "client": {
      "inject": [
        "@freddie/freddie-client-locale",
        "@freddie/freddie-client-ui-conversation",
        "@freddie/freddie-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "files": [
    "src/index.js",
    "src/invariant.js",
    "src/client/index.js",
    "src/client/controller.js",
    "src/client/applications.js",
    "src/client/OpenInAppAction.js",
    "src/client/OpenInAppAction.css.js",
    "src/client/locales.js"
  ],
  "license": "MIT",
  "dependencies": { "@freddie/webjsx": "*" },
  "peerDependencies": {
    "@freddie/cordis": "*",
    "@freddie/freddie-client-locale": "*",
    "@freddie/freddie-client-ui-conversation": "*",
    "@freddie/freddie-invariants": "*"
  },
  "devDependencies": {
    "@freddie/cordis": "*",
    "@freddie/freddie-client-locale": "*",
    "@freddie/freddie-client-ui-conversation": "*",
    "@freddie/freddie-client-ui-primitives": "*",
    "@freddie/freddie-client-ui-slots": "*",
    "@freddie/freddie-invariants": "*"
  }
}
