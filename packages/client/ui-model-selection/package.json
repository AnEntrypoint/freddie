{
  "name": "@freddie/freddie-client-ui-model-selection",
  "description": "Model selection: the /model popupSelect over session.models / session.selectModel",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/client/ui-model-selection"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./client": {
      "default": "./src/client/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "freddie": {
    "client": {
      "inject": [
        "@freddie/freddie-client-locale",
        "@freddie/freddie-client-runtime",
        "@freddie/freddie-client-ui-commands",
        "@freddie/freddie-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@freddie/freddie-api-remotes": "workspace:^",
    "@freddie/freddie-client-connection": "workspace:^",
    "@freddie/freddie-client-locale": "workspace:^",
    "@freddie/freddie-client-runtime": "workspace:^",
    "@freddie/freddie-client-ui-commands": "workspace:^",
    "@freddie/freddie-client-ui-conversation": "workspace:^",
    "@freddie/freddie-client-ui-input-trigger": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/cordis": "workspace:^"
  },
  "devDependencies": {
    "@freddie/freddie-api-remotes": "workspace:^",
    "@freddie/freddie-client-connection": "workspace:^",
    "@freddie/freddie-client-locale": "workspace:^",
    "@freddie/freddie-client-runtime": "workspace:^",
    "@freddie/freddie-client-ui-commands": "workspace:^",
    "@freddie/freddie-client-ui-conversation": "workspace:^",
    "@freddie/freddie-client-ui-input-trigger": "workspace:^",
    "@freddie/freddie-client-ui-primitives": "workspace:^",
    "@freddie/freddie-client-ui-slots": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/cordis": "workspace:^"
  },
  "files": [
    "src/*.js",
    "src/client/*.js",
    "src/client/ModelSelect.css"
  ],
  "dependencies": {
    "clsx": "^2.1.1",
    "webjsx": "^0.0.73"
  }
}
