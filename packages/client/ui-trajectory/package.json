{
  "name": "@freddie/freddie-client-ui-trajectory",
  "description": "Trajectory event ledger with an interactive timing overview: pure-consumer plugin registering into the conversation ViewMap (no service)",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/client/ui-trajectory"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./client": {
      "default": "./src/client/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "freddie": {
    "client": {
      "inject": [
        "@freddie/freddie-client-locale",
        "@freddie/freddie-client-runtime",
        "@freddie/freddie-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@tanstack/virtual-core": "^3.17.7",
    "diff": "^9.0.0",
    "@freddie/webjsx": "*"
  },
  "peerDependencies": {
    "@freddie/freddie-agent": "*",
    "@freddie/freddie-client-locale": "*",
    "@freddie/freddie-client-runtime": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/cordis": "*",
    "@freddie/freddie-compaction": "*",
    "@freddie/freddie-tools": "*",
    "@freddie/freddie-client-ui-conversation": "*"
  },
  "devDependencies": {
    "@freddie/freddie-agent": "*",
    "@freddie/freddie-client-locale": "*",
    "@freddie/freddie-client-runtime": "*",
    "@freddie/freddie-client-ui-primitives": "*",
    "@freddie/freddie-client-ui-conversation": "*",
    "@freddie/freddie-client-ui-slots": "*",
    "@freddie/freddie-compaction": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-tools": "*",
    "@freddie/cordis": "*"
  },
  "files": [
    "src/**/*.js"
  ]
}
