{
  "name": "@freddie/freddie-client-ui-workspace",
  "description": "Workspace picker plugin: one WorkspacePicker registered into the sidebar and empty-state workspace slots",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/client/ui-workspace"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./client": {
      "default": "./src/client/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "freddie": {
    "client": {
      "inject": [
        "@freddie/freddie-client-connection",
        "@freddie/freddie-client-locale",
        "@freddie/freddie-client-runtime",
        "@freddie/freddie-client-ui-conversation",
        "@freddie/freddie-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "@freddie/webjsx": "*"
  },
  "peerDependencies": {
    "@freddie/freddie-client-connection": "*",
    "@freddie/freddie-client-locale": "*",
    "@freddie/freddie-client-runtime": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/cordis": "*",
    "@freddie/freddie-client-ui-conversation": "*",
    "@freddie/freddie-client-ui-sidebar": "*"
  },
  "devDependencies": {
    "@freddie/freddie-client-connection": "*",
    "@freddie/freddie-client-locale": "*",
    "@freddie/freddie-client-runtime": "*",
    "@freddie/freddie-client-ui-conversation": "*",
    "@freddie/freddie-client-ui-primitives": "*",
    "@freddie/freddie-client-ui-sidebar": "*",
    "@freddie/freddie-client-ui-slots": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/cordis": "*"
  },
  "files": [
    "src/index.js",
    "src/invariant.js",
    "src/client/index.js",
    "src/client/WorkspaceBrowser.js",
    "src/client/WorkspaceBrowser.css.js",
    "src/client/WorkspacePicker.js",
    "src/client/WorkspacePicker.css.js",
    "src/client/locales.js",
    "src/client/stores.js",
    "src/client/tree.js",
    "src/client/contract/slots.js",
    "src/client/rows/Rows.js",
    "src/client/rows/Rows.css.js"
  ]
}
