{
  "name": "@freddie/freddie-client-ui-reference",
  "description": "Unified Web @file and @session reference source",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/client/ui-reference"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./client": {
      "default": "./src/client/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "freddie": {
    "client": {
      "inject": [
        "@freddie/freddie-client-runtime",
        "@freddie/freddie-api-remotes",
        "@freddie/freddie-client-locale",
        "@freddie/freddie-client-ui-input-trigger"
      ],
      "platform": "web",
      "external": [
        "@freddie/freddie-file-reference/grammar"
      ]
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@freddie/freddie-api-remotes": "*",
    "@freddie/freddie-client-locale": "*",
    "@freddie/freddie-client-runtime": "*",
    "@freddie/freddie-client-ui-input-trigger": "*",
    "@freddie/freddie-file-reference": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-session-reference": "*",
    "@freddie/freddie-typert-protocol": "*",
    "@freddie/cordis": "*"
  },
  "devDependencies": {
    "@freddie/freddie-api-remotes": "*",
    "@freddie/freddie-client-locale": "*",
    "@freddie/freddie-client-runtime": "*",
    "@freddie/freddie-client-ui-input-trigger": "*",
    "@freddie/freddie-client-ui-slots": "*",
    "@freddie/freddie-file-reference": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-session-reference": "*",
    "@freddie/freddie-typert-protocol": "*",
    "@freddie/cordis": "*"
  },
  "files": [
    "src/index.js",
    "src/invariant.js",
    "src/client/index.js",
    "src/client/locales.js"
  ]
}
