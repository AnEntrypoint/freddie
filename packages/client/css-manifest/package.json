{
  "name": "@freddie/freddie-client-css-manifest",
  "description": "Serves the buildless plain CSS files converted off CSS Modules and injects one <link rel=\"stylesheet\"> per file into the page head, from a static build-time manifest",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/client/css-manifest"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/*.js"
  ],
  "license": "MIT",
  "scripts": {
    "generate-manifest": "node scripts/generate-manifest.mjs"
  },
  "peerDependencies": {
    "@freddie/freddie-host-webserver": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/cordis": "workspace:^"
  },
  "devDependencies": {
    "@freddie/freddie-host-webserver": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/cordis": "workspace:^"
  }
}
