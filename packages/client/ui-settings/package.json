{
  "name": "@freddie/freddie-client-ui-settings",
  "description": "Settings domain base plugin: the settings-namespace scope service and the canonical settings slot-type contract",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/client/ui-settings"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./client": {
      "default": "./src/client/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "freddie": {
    "client": {
      "inject": [
        "@freddie/freddie-client-connection",
        "@freddie/freddie-client-runtime",
        "@freddie/freddie-api-remotes"
      ],
      "platform": "web",
      "external": [
        "@freddie/schemastery"
      ]
    }
  },
  "license": "MIT",
  "dependencies": {
    "@freddie/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@freddie/cordis": "workspace:^",
    "@freddie/freddie-api-remotes": "workspace:^",
    "@freddie/freddie-client-connection": "workspace:^",
    "@freddie/freddie-client-runtime": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/freddie-settings": "workspace:^"
  },
  "devDependencies": {
    "@freddie/cordis": "workspace:^",
    "@freddie/freddie-api-remotes": "workspace:^",
    "@freddie/freddie-client-runtime": "workspace:^",
    "@freddie/freddie-client-ui-slots": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/freddie-settings": "workspace:^",
    "@freddie/freddie-client-connection": "workspace:^"
  },
  "files": [
    "src/*.js",
    "src/client/*.js",
    "src/client/contract/*.js"
  ]
}
