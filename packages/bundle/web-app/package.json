    "directory": "packages/bundle/web-app"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./startup": {
      "default": "./src/startup.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.js",
    "src/invariant.js",
    "src/startup.js",
    "cordis.patch.yml"
  ],
  "license": "MIT",
