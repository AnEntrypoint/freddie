{
  "name": "@freddie/freddie-spill-policy",
  "description": "Tool-result spill policy for the Freddie — replaces oversized plain-text tool results with a retained preview plus a spill-file path (no service API)",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/spill/spill-policy"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.js",
    "src/invariant.js"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-llm": "*",
    "@freddie/freddie-output-retention": "*",
    "@freddie/freddie-session": "*",
    "@freddie/freddie-spill": "*",
    "@freddie/freddie-tools": "*",
    "@freddie/cordis": "*"
  },
  "dependencies": {
    "@freddie/schemastery": "*"
  },
  "devDependencies": {
    "@freddie/freddie-agent": "*",
    "@freddie/freddie-code-runtime-worker-thread": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-llm": "*",
    "@freddie/freddie-output-retention": "*",
    "@freddie/freddie-session": "*",
    "@freddie/freddie-spill": "*",
    "@freddie/freddie-tools": "*",
    "@freddie/cordis": "*"
  }
}
