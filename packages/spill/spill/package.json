{
  "name": "@freddie/freddie-spill",
  "description": "Abstract spill storage seam (ctx.spillStore) for the Freddie — save oversized tool text and return a retrieval locator",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/spill/spill"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.js",
    "src/invariant.js",
    "src/types.js"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@freddie/freddie-brand": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-llm": "*",
    "@freddie/freddie-session": "*",
    "@freddie/cordis": "*"
  },
  "devDependencies": {
    "@freddie/freddie-brand": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-llm": "*",
    "@freddie/freddie-session": "*",
    "@freddie/cordis": "*"
  }
}
