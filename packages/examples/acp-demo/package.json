    "@freddie/freddie-session-persistence-jsonl": "workspace:^",
    "@freddie/freddie-session-query": "workspace:^",
    "@freddie/freddie-session-query-sqlite": "workspace:^",
    "@freddie/freddie-tools": "workspace:^",
    "@freddie/freddie-agent-instructions": "workspace:^",
    "@freddie/cordis": "workspace:^",
    "@freddie/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@freddie/cordis-plugin-include": "workspace:^",
    "@freddie/cordis-plugin-loader": "workspace:^",
    "@freddie/freddie-acp": "workspace:^",
