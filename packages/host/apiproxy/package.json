{
  "name": "@freddie/freddie-host-apiproxy",
  "description": "API gateway: the ApiProxy contract (api/), the fetch carrier pair (fetch/), and the host-side gateway plugin providing ctx.apiProxy",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/host/apiproxy"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./api": {
      "default": "./src/api/index.js"
    },
    "./api/*": {
      "default": "./src/api/*.js"
    },
    "./client": {
      "default": "./src/fetch/client.js"
    }
  },
  "files": [
    "src/**/*.js"
  ],
  "license": "MIT",
  "dependencies": {
    "@freddie/freddie-attachment": "*",
    "@freddie/freddie-agent": "*",
    "@freddie/freddie-api-remotes": "*",
    "@freddie/freddie-brand": "*",
    "@freddie/freddie-commands": "*",
    "@freddie/freddie-credentials": "*",
    "@freddie/freddie-goal": "*",
    "@freddie/freddie-host-directory-picker": "*",
    "@freddie/freddie-llm": "*",
    "@freddie/freddie-native-command": "*",
    "@freddie/freddie-session": "*",
    "@freddie/freddie-session-persistence": "*",
    "@freddie/freddie-session-projection": "*",
    "@freddie/freddie-session-projection-cache": "*",
    "@freddie/freddie-session-query": "*",
    "@freddie/freddie-session-title": "*",
    "@freddie/freddie-settings": "*",
    "@freddie/freddie-skill": "*",
    "@freddie/freddie-subagent": "*",
    "@freddie/freddie-terminal": "*",
    "@freddie/freddie-jobs": "*",
    "@freddie/freddie-tools": "*",
    "@freddie/freddie-user-approval": "*",
    "@freddie/freddie-user-questions": "*",
    "@freddie/freddie-workspace": "*",
    "@freddie/schemastery": "*",
    "fflate": "^0.8.2"
  },
  "peerDependencies": {
    "@freddie/cordis": "*",
    "@freddie/freddie-agent-presets": "*",
    "@freddie/freddie-cordis-host-runner": "*",
    "@freddie/freddie-invariants": "*"
  },
  "devDependencies": {
    "@freddie/cordis": "*",
    "@freddie/freddie-agent-presets": "*",
    "@freddie/freddie-cordis-host-runner": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-storage": "*",
    "@freddie/freddie-storage-domain": "*",
    "@freddie/freddie-typert-protocol": "*",
    "@freddie/freddie-typert-registry": "*"
  }
