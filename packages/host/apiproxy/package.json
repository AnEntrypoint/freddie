{
  "name": "@freddie/freddie-host-apiproxy",
  "description": "API gateway: the ApiProxy contract (api/), the fetch carrier pair (fetch/), and the host-side gateway plugin providing ctx.apiProxy",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/host/apiproxy"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./api": {
      "default": "./src/api/index.js"
    },
    "./api/*": {
      "default": "./src/api/*.js"
    },
    "./client": {
      "default": "./src/fetch/client.js"
    }
  },
  "files": [
    "src/**/*.js"
  ],
  "license": "MIT",
  "dependencies": {
    "@freddie/freddie-attachment": "workspace:^",
    "@freddie/freddie-agent": "workspace:^",
    "@freddie/freddie-api-remotes": "workspace:^",
    "@freddie/freddie-brand": "workspace:^",
    "@freddie/freddie-commands": "workspace:^",
    "@freddie/freddie-credentials": "workspace:^",
    "@freddie/freddie-goal": "workspace:^",
    "@freddie/freddie-host-directory-picker": "workspace:^",
    "@freddie/freddie-llm": "workspace:^",
    "@freddie/freddie-native-command": "workspace:^",
    "@freddie/freddie-session": "workspace:^",
    "@freddie/freddie-session-persistence": "workspace:^",
    "@freddie/freddie-session-projection": "workspace:^",
    "@freddie/freddie-session-projection-cache": "workspace:^",
    "@freddie/freddie-session-query": "workspace:^",
    "@freddie/freddie-session-title": "workspace:^",
    "@freddie/freddie-settings": "workspace:^",
    "@freddie/freddie-skill": "workspace:^",
    "@freddie/freddie-subagent": "workspace:^",
    "@freddie/freddie-jobs": "workspace:^",
    "@freddie/freddie-tools": "workspace:^",
    "@freddie/freddie-user-approval": "workspace:^",
    "@freddie/freddie-user-questions": "workspace:^",
    "@freddie/freddie-workspace": "workspace:^",
    "@freddie/schemastery": "workspace:^",
    "fflate": "^0.8.2"
  },
  "peerDependencies": {
    "@freddie/cordis": "workspace:^",
    "@freddie/freddie-agent-presets": "workspace:^",
    "@freddie/freddie-cordis-host-runner": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^"
  },
  "devDependencies": {
    "@freddie/cordis": "workspace:^",
    "@freddie/freddie-agent-presets": "workspace:^",
    "@freddie/freddie-cordis-host-runner": "workspace:^",
