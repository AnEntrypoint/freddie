  },
  "peerDependencies": {
    "@freddie/cordis": "*",
    "@freddie/freddie-host-webserver": "*"
  },
  "devDependencies": {
    "@freddie/cordis": "*",
    "@freddie/freddie-host-webserver": "*"
  }
