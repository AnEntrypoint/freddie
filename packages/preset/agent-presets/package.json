  },
  "files": [
    "src/**/*.js"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@freddie/cordis-plugin-include": "workspace:^",
    "@freddie/cordis-plugin-loader": "workspace:^",
    "@freddie/freddie-agent": "workspace:^",
    "@freddie/freddie-atomic-write": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/freddie-home-paths": "workspace:^",
    "@freddie/freddie-scope": "workspace:^",
    "@freddie/freddie-session": "workspace:^",
    "@freddie/freddie-settings": "workspace:^",
    "@freddie/freddie-system-prompt": "workspace:^",
    "@freddie/cordis": "workspace:^"
  },
  "dependencies": {
    "js-yaml": "^5.4.1",
    "@freddie/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@freddie/cordis-plugin-include": "workspace:^",
    "@freddie/cordis-plugin-loader": "workspace:^",
    "@freddie/freddie-agent": "workspace:^",
    "@freddie/freddie-agent-loop": "workspace:^",
    "@freddie/freddie-atomic-write": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
