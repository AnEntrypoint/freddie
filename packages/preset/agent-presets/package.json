    "@freddie/freddie-session": "*",
    "@freddie/freddie-settings": "*",
    "@freddie/freddie-system-prompt": "*",
    "@freddie/cordis": "*"
  },
  "dependencies": {
    "js-yaml": "^5.4.1",
    "@freddie/schemastery": "*"
  },
  "devDependencies": {
    "@freddie/cordis-plugin-include": "*",
    "@freddie/cordis-plugin-loader": "*",
    "@freddie/freddie-agent": "*",
    "@freddie/freddie-agent-loop": "*",
    "@freddie/freddie-atomic-write": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-llm": "*",
    "@freddie/freddie-home-paths": "*",
    "@freddie/freddie-scope": "*",
