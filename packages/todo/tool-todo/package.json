  },
  "devDependencies": {
    "@freddie/cordis-plugin-include": "*",
    "@freddie/cordis-plugin-loader": "*",
    "@freddie/freddie-agent": "*",
    "@freddie/freddie-agent-loop": "*",
    "@freddie/freddie-host-apiproxy": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-llm": "*",
    "@freddie/freddie-session": "*",
    "@freddie/freddie-session-projection": "*",
    "@freddie/freddie-system-prompt": "*",
    "@freddie/freddie-tools": "*",
    "@freddie/freddie-user-questions": "*",
    "@freddie/cordis": "*"
  }
