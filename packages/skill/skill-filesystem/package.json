{
  "name": "@freddie/freddie-skill-filesystem",
  "description": "Local filesystem skill provider for the Freddie",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/skill/skill-filesystem"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.js",
    "src/invariant.js"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@freddie/freddie-fs": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/freddie-home-paths": "workspace:^",
    "@freddie/freddie-skill": "workspace:^",
    "@freddie/cordis": "workspace:^"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "@freddie/schemastery": "workspace:^",
    "js-yaml": "^5.4.1"
  },
  "devDependencies": {
    "@freddie/freddie-fs": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/freddie-home-paths": "workspace:^",
    "@freddie/freddie-skill": "workspace:^",
    "@freddie/cordis": "workspace:^"
  }
}
