{
  "name": "@freddie/freddie-tools",
  "description": "Tool registry and execution pipeline for the Freddie",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/core/tools"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./types": {
      "default": "./src/types.js"
    },
    "./presentation": {
      "default": "./src/presentation.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/*.js"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@freddie/freddie-agent": "*",
    "@freddie/freddie-code-runtime": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-llm": "*",
    "@freddie/freddie-scope": "*",
    "@freddie/freddie-session": "*",
    "@freddie/freddie-system-prompt": "*",
    "@freddie/freddie-user-approval": "*",
    "@freddie/cordis": "*"
  },
  "dependencies": {
    "@freddie/schemastery": "*"
  },
  "devDependencies": {
    "@freddie/freddie-agent": "*",
    "@freddie/freddie-code-runtime": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-llm": "*",
    "@freddie/freddie-scope": "*",
    "@freddie/freddie-session": "*",
    "@freddie/freddie-system-prompt": "*",
    "@freddie/freddie-user-approval": "*",
    "@freddie/cordis": "*"
  }
}
