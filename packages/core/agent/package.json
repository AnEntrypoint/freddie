{
  "name": "@freddie/freddie-agent",
  "description": "Agent interface, registry, initiator scope, and event vocabulary for the Freddie",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/core/agent"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./types": {
      "default": "./src/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.js",
    "src/invariant.js",
    "src/types.js",
    "src/dispatch.js",
    "src/inbox.js",
    "src/consumed-work.js",
    "src/model-selection.js",
    "src/runtime-types.js"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-llm": "*",
    "@freddie/freddie-scope": "*",
    "@freddie/freddie-session": "*",
    "@freddie/freddie-system-prompt": "*",
    "@freddie/freddie-typert-protocol": "*",
    "@freddie/cordis": "*"
  },
  "devDependencies": {
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-llm": "*",
    "@freddie/freddie-scope": "*",
    "@freddie/freddie-session": "*",
    "@freddie/freddie-system-prompt": "*",
    "@freddie/freddie-typert-protocol": "*",
    "@freddie/freddie-typert-registry": "*",
    "@freddie/cordis": "*"
  }
}
