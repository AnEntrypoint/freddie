{
  "name": "@freddie/freddie-agent-fx",
  "description": "Agent engine over fx:host/agent for the Freddie: runs a step through fx with freddie tools as custom JS tools, a custom provider and the system context, and records the turn in the session log",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/core/agent-fx"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/*.js"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@freddie/cordis": "*",
    "@freddie/freddie-agent-loop": "*",
    "@freddie/freddie-credentials": "*",
    "@freddie/freddie-llm": "*"
  },
  "dependencies": {
    "@freddie/schemastery": "*"
  },
  "devDependencies": {
    "@freddie/cordis": "*",
    "@freddie/freddie-agent-loop": "*",
    "@freddie/freddie-credentials": "*",
    "@freddie/freddie-llm": "*",
    "@freddie/freddie-runtime": "*",
    "@freddie/freddie-session": "*"
  }
}
