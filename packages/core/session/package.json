{
  "name": "@freddie/freddie-session",
  "description": "Event-sourced session store for the Freddie",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/core/session"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./types": {
      "default": "./src/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./surface": {
      "default": "./src/surface.js"
    }
  },
  "files": [
    "src/*.js"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@freddie/freddie-brand": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-llm": "*",
    "@freddie/freddie-scope": "*",
    "@freddie/freddie-typert-protocol": "*",
    "@freddie/cordis": "*"
  },
  "devDependencies": {
    "@freddie/freddie-brand": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-llm": "*",
    "@freddie/freddie-scope": "*",
    "@freddie/freddie-typert-protocol": "*",
    "@freddie/freddie-typert-registry": "*",
    "@freddie/cordis": "*"
  }
}
