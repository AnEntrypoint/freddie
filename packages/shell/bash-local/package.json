{
  "name": "@freddie/freddie-bash-local",
  "description": "Local-subprocess implementation of the Freddie bash executor seam",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/shell/bash-local"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.js",
    "src/invariant.js"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@freddie/freddie-shell": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/freddie-subprocess": "workspace:^",
    "@freddie/freddie-timeout": "workspace:^",
    "@freddie/cordis": "workspace:^",
    "@freddie/freddie-settings": "workspace:^"
  },
  "dependencies": {
    "@freddie/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@freddie/freddie-shell": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/freddie-subprocess": "workspace:^",
    "@freddie/freddie-subprocess-local": "workspace:^",
    "@freddie/freddie-timeout": "workspace:^",
    "@freddie/cordis": "workspace:^",
    "@freddie/freddie-settings": "workspace:^"
  }
}
