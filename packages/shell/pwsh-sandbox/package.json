{
  "name": "@freddie/freddie-pwsh-sandbox",
  "description": "Sandbox-consuming implementation of the Freddie PowerShell executor seam (confines every command via ctx.sandbox, reports denial/enforcement result facts)",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/shell/pwsh-sandbox"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.js",
    "src/helpers.js",
    "src/invariant.js"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@freddie/freddie-shell": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/freddie-pwsh-local": "workspace:^",
    "@freddie/freddie-sandbox": "workspace:^",
    "@freddie/freddie-sandbox-policy": "workspace:^",
    "@freddie/cordis": "workspace:^"
  },
  "devDependencies": {
    "@freddie/freddie-shell": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/freddie-pwsh-local": "workspace:^",
    "@freddie/freddie-sandbox": "workspace:^",
    "@freddie/freddie-sandbox-local": "workspace:^",
    "@freddie/freddie-sandbox-policy": "workspace:^",
    "@freddie/freddie-subprocess-local": "workspace:^",
    "@freddie/cordis": "workspace:^"
  }
}
