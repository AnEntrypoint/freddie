{
  "name": "@freddie/freddie-pwsh-local",
  "description": "Local PowerShell implementation of the Freddie bash executor seam",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/shell/pwsh-local"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.js",
    "src/invariant.js",
    "src/resolve.js"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@freddie/freddie-shell": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-subprocess": "*",
    "@freddie/freddie-timeout": "*",
    "@freddie/cordis": "*",
    "@freddie/freddie-settings": "*"
  },
  "dependencies": {
    "@freddie/schemastery": "*"
  },
  "devDependencies": {
    "@freddie/freddie-shell": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-subprocess": "*",
    "@freddie/freddie-subprocess-local": "*",
    "@freddie/freddie-timeout": "*",
    "@freddie/cordis": "*",
    "@freddie/freddie-settings": "*"
  }
}
