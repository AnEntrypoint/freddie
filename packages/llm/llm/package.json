{
  "name": "@freddie/freddie-llm",
  "description": "Provider-neutral LLM service interface for the Freddie",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/llm/llm"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./types": {
      "default": "./src/types.js"
    },
    "./brand": {
      "default": "./src/brand.js"
    },
    "./message": {
      "default": "./src/message.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.js"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@freddie/freddie-attachment": "*",
    "@freddie/freddie-brand": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-timeout": "*",
    "@freddie/cordis": "*"
  },
  "dependencies": {
    "@freddie/schemastery": "*"
  },
  "devDependencies": {
    "@freddie/freddie-attachment": "*",
    "@freddie/freddie-brand": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-timeout": "*",
    "@freddie/cordis": "*"
  }
}
