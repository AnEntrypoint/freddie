{
  "name": "@freddie/freddie-permission-presets",
  "description": "User-facing permission presets (ctx.permissionPresets) for the Freddie: one product-level Permissions select bundling the sandbox-mode and approval-policy knobs, written through to their own session events",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/interaction/permission-presets"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./types": {
      "default": "./src/types.js"
    },
    "./client": {
      "default": "./src/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.js",
    "src/invariant.js",
    "src/types.js",
    "src/client.js"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@freddie/freddie-shell": "workspace:^",
    "@freddie/freddie-commands": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/freddie-sandbox": "workspace:^",
    "@freddie/freddie-sandbox-policy": "workspace:^",
    "@freddie/freddie-session": "workspace:^",
    "@freddie/freddie-session-projection": "workspace:^",
    "@freddie/freddie-settings": "workspace:^",
    "@freddie/freddie-user-approval": "workspace:^",
    "@freddie/cordis": "workspace:^"
  },
  "dependencies": {
    "@freddie/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@freddie/freddie-shell": "workspace:^",
    "@freddie/freddie-commands": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/freddie-sandbox": "workspace:^",
    "@freddie/freddie-sandbox-policy": "workspace:^",
    "@freddie/freddie-session": "workspace:^",
    "@freddie/freddie-session-projection": "workspace:^",
    "@freddie/freddie-settings": "workspace:^",
    "@freddie/freddie-user-approval": "workspace:^",
    "@freddie/cordis": "workspace:^"
  }
}
