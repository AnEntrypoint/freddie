{
  "name": "@freddie/freddie-fs-sandbox",
  "description": "Sandbox-enforcing implementation of the Freddie filesystem seam: fences write/edit by the per-call sandbox mode (read-only denies mutation, workspace-write contains it to the workspace + temp roots) while reads pass through",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/fs/fs-sandbox"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.js",
    "src/invariant.js",
    "src/containment.js"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@freddie/freddie-fs": "*",
    "@freddie/freddie-fs-local": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-sandbox": "*",
    "@freddie/freddie-sandbox-policy": "*",
    "@freddie/cordis": "*"
  },
  "devDependencies": {
    "@freddie/freddie-fs": "*",
    "@freddie/freddie-fs-local": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-sandbox": "*",
    "@freddie/freddie-sandbox-policy": "*",
    "@freddie/cordis": "*"
  }
}
