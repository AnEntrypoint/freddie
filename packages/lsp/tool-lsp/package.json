{
  "name": "@freddie/freddie-tool-lsp",
  "description": "Model-facing lsp tool over the Freddie LSP capability seam (ctx.lsp) — one read-only tool with goToDefinition/findReferences/goToImplementation/hover operations, one-based UTF-16 cursor coordinates, bounded location rendering, and hover normalization",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/lsp/tool-lsp"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.js"
  ],
  "license": "MIT",
  "dependencies": {
    "@freddie/schemastery": "*",
    "@freddie/freddie-values": "*"
  },
  "peerDependencies": {
    "@freddie/cordis": "*",
    "@freddie/freddie-lsp": "*",
    "@freddie/freddie-system-prompt": "*",
    "@freddie/freddie-timeout": "*",
    "@freddie/freddie-tools": "*"
  },
  "devDependencies": {
    "@freddie/cordis": "*",
    "@freddie/freddie-agent": "*",
    "@freddie/freddie-lsp": "*",
    "@freddie/freddie-lsp-stdio": "*",
    "@freddie/freddie-session": "*",
    "@freddie/freddie-system-prompt": "*",
    "@freddie/freddie-timeout": "*",
    "@freddie/freddie-tools": "*"
  }
}
