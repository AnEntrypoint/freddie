{
  "name": "@freddie/freddie-lsp-stdio",
  "description": "Generic stdio language-server provider for the Freddie LSP capability seam (ctx.lsp) — spawns configured servers, translates JSON-RPC, and serves transient-open goToDefinition/findReferences/goToImplementation/hover queries in the host filesystem namespace",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/lsp/lsp-stdio"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.js"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@freddie/freddie-brand": "workspace:^",
    "@freddie/freddie-fs": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/freddie-llm": "workspace:^",
    "@freddie/freddie-lsp": "workspace:^",
    "@freddie/freddie-subprocess": "workspace:^",
    "@freddie/freddie-timeout": "workspace:^",
    "@freddie/cordis": "workspace:^"
  },
  "dependencies": {
    "@freddie/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@freddie/freddie-brand": "workspace:^",
    "@freddie/freddie-fs": "workspace:^",
    "@freddie/freddie-fs-local": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/freddie-llm": "workspace:^",
    "@freddie/freddie-lsp": "workspace:^",
    "@freddie/freddie-subprocess": "workspace:^",
    "@freddie/freddie-subprocess-local": "workspace:^",
    "@freddie/freddie-timeout": "workspace:^",
    "@freddie/cordis": "workspace:^"
  }
}
