  },
  "files": [
    "src/index.js",
    "src/invariant.js",
    "src/api-catalog.js",
    "src/fiber-state.js",
    "src/inspect.js",
    "src/present.js",
    "src/prompt.js",
    "src/providers.js"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@freddie/freddie-agent": "*",
    "@freddie/freddie-cordis-host-runner": "*",
