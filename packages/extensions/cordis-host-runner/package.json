{
  "name": "@freddie/freddie-cordis-host-runner",
  "description": "Dynamic package definition registry, host-half sandbox lifecycle, and invoke handler table for model-mounted dual-half packages",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/extensions/cordis-host-runner"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./types": {
      "default": "./src/types.js"
    },
    "./typert": {
      "default": "./src/typert.host.js"
    },
    "./remote": {
      "default": "./src/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/*.js"
  ],
  "license": "MIT",
  "dependencies": {
    "@freddie/schemastery": "*",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@freddie/cordis": "*",
    "@freddie/freddie-agent": "*",
    "@freddie/freddie-brand": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-llm": "*",
    "@freddie/freddie-scope": "*",
    "@freddie/freddie-session": "*",
    "@freddie/freddie-tools": "*",
    "@freddie/freddie-typert-protocol": "*"
  },
  "devDependencies": {
    "@freddie/cordis": "*",
    "@freddie/cordis-plugin-timer": "*",
    "@freddie/freddie-agent": "*",
    "@freddie/freddie-brand": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-llm": "*",
    "@freddie/freddie-scope": "*",
    "@freddie/freddie-session": "*",
    "@freddie/freddie-tools": "*",
    "@freddie/freddie-typert-protocol": "*"
  }
}
