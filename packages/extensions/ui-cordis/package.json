{
  "name": "@freddie/freddie-client-ui-cordis",
  "description": "Cordis dynamic-plugin definition card: the keyed cordis_define tool row with its run/stop switch",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/extensions/ui-cordis"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./client": {
      "default": "./src/client/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "freddie": {
    "client": {
      "inject": [
        "@freddie/freddie-client-runtime",
        "@freddie/freddie-client-connection",
        "@freddie/freddie-cordis-client-runner",
        "@freddie/freddie-api-remotes",
        "@freddie/freddie-client-locale",
        "@freddie/freddie-client-ui-input-trigger",
        "@freddie/freddie-client-ui-tool",
        "@freddie/freddie-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@freddie/freddie-api-remotes": "workspace:^",
    "@freddie/freddie-client-connection": "workspace:^",
    "@freddie/freddie-cordis-client-runner": "workspace:^",
    "@freddie/freddie-client-locale": "workspace:^",
    "@freddie/freddie-client-runtime": "workspace:^",
    "@freddie/freddie-client-ui-sidebar": "workspace:^",
    "@freddie/freddie-client-ui-input-trigger": "workspace:^",
    "@freddie/freddie-client-ui-tool": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/cordis": "workspace:^"
  },
  "devDependencies": {
    "@freddie/freddie-api-remotes": "workspace:^",
    "@freddie/freddie-client-connection": "workspace:^",
    "@freddie/freddie-cordis-client-runner": "workspace:^",
    "@freddie/freddie-client-locale": "workspace:^",
    "@freddie/freddie-client-runtime": "workspace:^",
    "@freddie/freddie-client-ui-primitives": "workspace:^",
    "@freddie/freddie-client-ui-sidebar": "workspace:^",
    "@freddie/freddie-client-ui-input-trigger": "workspace:^",
    "@freddie/freddie-client-ui-slots": "workspace:^",
    "@freddie/freddie-client-ui-tool": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/cordis": "workspace:^",
    "webjsx": "^0.0.73"
  },
  "files": [
    "src/**/*.js"
  ]
}
