{
  "name": "@freddie/freddie-hook-protocol",
  "description": "Shared Claude Code / Codex hook wire protocol: matcher engine, stdin/exit-code/stdout codec, multi-hook merge, and hook/* session events",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/hooks/hook-protocol"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/*.js"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@freddie/freddie-shell": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/freddie-session": "workspace:^",
    "@freddie/cordis": "workspace:^"
  },
  "devDependencies": {
    "@freddie/freddie-shell": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/freddie-session": "workspace:^",
    "@freddie/cordis": "workspace:^"
  }
}
