{
  "name": "@freddie/freddie-workspace-changes",
  "description": "Per-turn workspace file changes recorded from git working-tree snapshots and whole-file captures, with per-file comparisons",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/deliverables/workspace-changes"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/*.js"
  ],
  "license": "MIT",
  "dependencies": {
    "@freddie/schemastery": "*",
    "diff": "^9.0.0"
  },
  "peerDependencies": {
    "@freddie/cordis": "*",
    "@freddie/freddie-agent": "*",
    "@freddie/freddie-session": "*",
    "@freddie/freddie-subprocess": "*",
    "@freddie/freddie-tools": "*"
  },
  "devDependencies": {
    "@freddie/cordis": "*",
    "@freddie/freddie-agent": "*",
    "@freddie/freddie-session": "*",
    "@freddie/freddie-subprocess": "*",
    "@freddie/freddie-subprocess-local": "*",
    "@freddie/freddie-tools": "*"
  }
}
