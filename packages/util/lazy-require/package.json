{
  "name": "@freddie/freddie-lazy-require",
  "description": "Caller-relative lazy loading, with success caching, for CommonJS-compatible optional dependencies",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/util/lazy-require"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.js"
  ],
  "license": "MIT"
}
