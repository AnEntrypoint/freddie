{
  "name": "@freddie/freddie-gm-client",
  "description": "Cordis-native ctx.gm: dispatches gm spool verbs directly against .gm/exec-spool/, in-process, no MCP hop, boot-if-needed against the shared machine-wide native agentplug-runner daemon",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/gm/gm-client"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./typert": {
      "default": "./src/typert.host.js"
    },
    "./remote": {
      "default": "./src/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.js"
  ],
  "license": "MIT",
  "dependencies": {
    "@freddie/freddie-gm-config": "*",
    "@freddie/schemastery": "*",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@freddie/cordis": "*",
    "@freddie/freddie-gm-config": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-typert-protocol": "*"
  },
  "devDependencies": {
    "@freddie/cordis": "*",
    "@freddie/freddie-gm-config": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-typert-protocol": "*"
  }
}
