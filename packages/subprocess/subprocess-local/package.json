{
  "name": "@freddie/freddie-subprocess-local",
  "description": "Local-subprocess implementation of the Freddie subprocess seam",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/subprocess/subprocess-local"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/*.js",
    "scripts/ensure-spawn-helper.mjs"
  ],
  "scripts": {
    "postinstall": "node scripts/ensure-spawn-helper.mjs"
  },
  "license": "MIT",
  "peerDependencies": {
    "@freddie/freddie-subprocess": "*",
    "@freddie/freddie-timeout": "*",
    "@freddie/cordis": "*"
  },
  "dependencies": {
    "@freddie/freddie-runtime": "*"
  },
  "devDependencies": {
    "@freddie/freddie-subprocess": "*",
    "@freddie/freddie-timeout": "*",
    "@freddie/cordis": "*"
  }
}
