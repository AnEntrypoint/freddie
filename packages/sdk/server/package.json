{
  "name": "@freddie/freddie-sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process Freddie SDK clients",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.js"
  ],
  "license": "MIT",
  "dependencies": {
    "@freddie/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@freddie/freddie-agent": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/freddie-llm": "workspace:^",
    "@freddie/freddie-llm-deepseek": "workspace:^",
    "@freddie/freddie-scope": "workspace:^",
    "@freddie/freddie-sdk-protocol": "workspace:^",
    "@freddie/freddie-session": "workspace:^",
    "@freddie/freddie-subagent": "workspace:^",
    "@freddie/cordis": "workspace:^"
  },
  "devDependencies": {
    "@freddie/cordis-plugin-loader": "workspace:^",
    "@freddie/freddie-agent": "workspace:^",
    "@freddie/freddie-agent-spine-demo": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/freddie-llm": "workspace:^",
    "@freddie/freddie-llm-deepseek": "workspace:^",
    "@freddie/freddie-scope": "workspace:^",
    "@freddie/freddie-sdk-protocol": "workspace:^",
    "@freddie/freddie-session": "workspace:^",
    "@freddie/freddie-session-persistence-jsonl": "workspace:^",
    "@freddie/freddie-subagent": "workspace:^",
    "@freddie/cordis": "workspace:^"
  }
}
