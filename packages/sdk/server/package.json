{
  "name": "@freddie/freddie-sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process Freddie SDK clients",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.js"
  ],
  "license": "MIT",
  "dependencies": {
    "@freddie/schemastery": "*"
  },
  "peerDependencies": {
    "@freddie/freddie-agent": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-llm": "*",
    "@freddie/freddie-llm-deepseek": "*",
    "@freddie/freddie-scope": "*",
    "@freddie/freddie-sdk-protocol": "*",
    "@freddie/freddie-session": "*",
    "@freddie/freddie-subagent": "*",
    "@freddie/cordis": "*"
  },
  "devDependencies": {
    "@freddie/cordis-plugin-loader": "*",
    "@freddie/freddie-agent": "*",
    "@freddie/freddie-agent-spine-demo": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-llm": "*",
    "@freddie/freddie-llm-deepseek": "*",
    "@freddie/freddie-scope": "*",
    "@freddie/freddie-sdk-protocol": "*",
    "@freddie/freddie-session": "*",
    "@freddie/freddie-session-persistence-jsonl": "*",
    "@freddie/freddie-subagent": "*",
    "@freddie/cordis": "*"
  }
}
