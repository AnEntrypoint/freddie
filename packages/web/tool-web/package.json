    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@freddie/freddie-agent": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-llm": "*",
    "@freddie/freddie-session": "*",
    "@freddie/freddie-spill-local": "*",
