    "@freddie/freddie-system-prompt": "*",
    "@freddie/freddie-tool-call-timeout-policy": "*",
    "@freddie/freddie-tools": "*",
    "@freddie/freddie-web": "*",
    "@freddie/freddie-web-fetch-http": "*",
    "@freddie/freddie-web-search-exa": "*",
    "@freddie/cordis": "*"
  }
