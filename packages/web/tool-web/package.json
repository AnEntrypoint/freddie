{
  "name": "@freddie/freddie-tool-web",
  "description": "Model-facing web tools (web_search, web_fetch) over the Freddie web capability seam (ctx.web)",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/web/tool-web"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.js",
    "src/invariant.js",
    "src/fetch.js",
    "src/search.js"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/freddie-llm": "workspace:^",
    "@freddie/freddie-system-prompt": "workspace:^",
    "@freddie/freddie-tools": "workspace:^",
    "@freddie/freddie-web": "workspace:^",
    "@freddie/cordis": "workspace:^"
  },
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "@freddie/schemastery": "workspace:^",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@freddie/freddie-agent": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/freddie-llm": "workspace:^",
    "@freddie/freddie-session": "workspace:^",
    "@freddie/freddie-spill-local": "workspace:^",
    "@freddie/freddie-spill-policy": "workspace:^",
    "@freddie/freddie-system-prompt": "workspace:^",
    "@freddie/freddie-tool-call-timeout-policy": "workspace:^",
    "@freddie/freddie-tools": "workspace:^",
    "@freddie/freddie-web": "workspace:^",
    "@freddie/freddie-web-fetch-http": "workspace:^",
    "@freddie/freddie-web-search-exa": "workspace:^",
    "@freddie/cordis": "workspace:^"
  }
