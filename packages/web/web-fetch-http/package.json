{
  "name": "@freddie/freddie-web-fetch-http",
  "description": "Anonymous public HTTP(S) fetch provider for the Freddie web capability seam (ctx.web)",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/web/web-fetch-http"
  },
  "type": "module",
  "main": "src/index.js",
