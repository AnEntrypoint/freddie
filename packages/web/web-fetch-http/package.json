  },
  "dependencies": {
    "@freddie/schemastery": "*"
  },
  "devDependencies": {
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-timeout": "*",
    "@freddie/freddie-web": "*",
    "@freddie/cordis": "*"
  }
}
