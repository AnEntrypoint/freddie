{
  "name": "@freddie/freddie-web-search-browser",
  "description": "DuckDuckGo-via-browser-automation search provider (no API key) for the Freddie web capability seam (ctx.web), driven through ctx.gm's browser verb",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/web/web-search-browser"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.js",
    "src/provider.js"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@freddie/freddie-gm-client": "workspace:^",
    "@freddie/freddie-web": "workspace:^",
    "@freddie/cordis": "workspace:^"
  },
  "dependencies": {
    "@freddie/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@freddie/freddie-gm-client": "workspace:^",
    "@freddie/freddie-web": "workspace:^",
    "@freddie/cordis": "workspace:^"
  }
}
