{
  "name": "@freddie/freddie-webhook",
  "description": "Fire-and-forget webhook rule runtime that creates Workspace-backed Freddie Sessions",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/webhook/webhook"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.js"
  ],
  "license": "MIT",
  "dependencies": {
    "@freddie/freddie-values": "*"
  },
  "peerDependencies": {
    "@freddie/cordis": "*",
    "@freddie/freddie-agent": "*",
    "@freddie/freddie-agent-default-model": "*",
    "@freddie/freddie-agent-presets": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-llm": "*",
    "@freddie/freddie-permission-presets": "*",
    "@freddie/freddie-session": "*",
    "@freddie/freddie-session-title": "*",
    "@freddie/freddie-workspace": "*"
  },
  "devDependencies": {
    "@freddie/cordis": "*",
    "@freddie/freddie-agent": "*",
    "@freddie/freddie-agent-default-model": "*",
    "@freddie/freddie-agent-presets": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-llm": "*",
    "@freddie/freddie-permission-presets": "*",
    "@freddie/freddie-session": "*",
    "@freddie/freddie-session-title": "*",
    "@freddie/freddie-workspace": "*"
  }
}
