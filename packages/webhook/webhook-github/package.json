    "@freddie/freddie-webhook": "*"
  },
  "devDependencies": {
    "@freddie/cordis": "*",
    "@freddie/freddie-credentials": "*",
    "@freddie/freddie-host-webserver": "*",
    "@freddie/freddie-webhook": "*"
  }
