{
  "name": "@freddie/freddie-session-log-export",
  "description": "Web Session-log export command and shared download dialog",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/session-query/session-log-export"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./client": {
      "default": "./src/client/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.js"
  ],
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@freddie/cordis": "*",
    "@freddie/freddie-client-locale": "*",
    "@freddie/freddie-client-runtime": "*",
    "@freddie/freddie-client-ui-commands": "*",
    "@freddie/freddie-client-ui-conversation": "*",
    "@freddie/freddie-commands": "*",
    "@freddie/freddie-invariants": "*"
  },
  "devDependencies": {
    "@freddie/cordis": "*",
    "@freddie/cordis-plugin-loader": "*",
    "@freddie/freddie-agent": "*",
    "@freddie/freddie-client-locale": "*",
    "@freddie/freddie-client-runtime": "*",
    "@freddie/freddie-client-ui-commands": "*",
    "@freddie/freddie-client-ui-conversation": "*",
    "@freddie/freddie-client-ui-primitives": "*",
    "@freddie/freddie-client-ui-slots": "*",
    "@freddie/freddie-commands": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-session": "*",
    "@freddie/webjsx": "*"
  },
  "freddie": {
    "client": {
      "inject": [
        "@freddie/freddie-client-locale",
        "@freddie/freddie-client-runtime",
        "@freddie/freddie-client-ui-commands",
        "@freddie/freddie-client-ui-conversation"
      ],
      "platform": "web"
    }
  }
}
