{
  "name": "@freddie/freddie-cmdline",
  "description": "Immutable command-line handoff from a dsh launcher to any app plugin that injects cmdlineArgs",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/boot/cmdline"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.js",
    "src/invariant.js"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@freddie/cordis-plugin-loader": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/cordis": "*"
  },
  "devDependencies": {
    "@freddie/cordis-plugin-include": "*",
    "@freddie/cordis-plugin-loader": "*",
    "commander": "^15.0.0",
    "@freddie/freddie-invariants": "*",
    "@freddie/cordis": "*"
  }
}
