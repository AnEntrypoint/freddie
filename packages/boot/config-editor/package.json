{
  "name": "@freddie/freddie-config-editor",
  "description": "Persistent edits to one profile's own patch layer (cordis.patch.yml), validated by the entry's fiber and applied to the live Loader tree",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/boot/config-editor"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.js",
    "src/invariant.js"
  ],
  "license": "MIT",
  "dependencies": {
    "@freddie/schemastery": "*",
    "js-yaml": "^5.4.1",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@freddie/cordis": "*",
    "@freddie/cordis-plugin-hmr": "*",
    "@freddie/cordis-plugin-include": "*",
    "@freddie/cordis-plugin-loader": "*",
    "@freddie/freddie-app-boot": "*",
    "@freddie/freddie-atomic-write": "*",
    "@freddie/freddie-invariants": "*"
  },
  "peerDependenciesMeta": {
    "@freddie/cordis-plugin-hmr": {
      "optional": true
    }
  },
  "devDependencies": {
    "@freddie/cordis": "*",
    "@freddie/cordis-plugin-hmr": "*",
    "@freddie/cordis-plugin-include": "*",
    "@freddie/cordis-plugin-loader": "*",
    "@freddie/freddie-app-boot": "*",
    "@freddie/freddie-atomic-write": "*",
    "@freddie/freddie-invariants": "*"
  }
}
