{
  "name": "@freddie/freddie-api-gateway",
  "description": "Typert Remote Host dispatcher and Client API endpoint",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/api/gateway"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./client": {
      "default": "./src/client/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "freddie": {
    "client": {
      "inject": [
        "@freddie/freddie-typert-registry",
        "@freddie/freddie-client-connection"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "src/*.js",
    "src/client/*.js"
  ],
  "license": "MIT",
  "dependencies": {
    "@freddie/freddie-typert-protocol": "workspace:^"
  },
  "peerDependencies": {
    "@freddie/freddie-client-connection": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/freddie-typert-registry": "workspace:^",
    "@freddie/cordis": "workspace:^"
  },
  "devDependencies": {
    "@freddie/freddie-client-connection": "workspace:^",
    "@freddie/freddie-host-webserver": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/freddie-typert-registry": "workspace:^",
    "@freddie/cordis": "workspace:^"
  }
}
