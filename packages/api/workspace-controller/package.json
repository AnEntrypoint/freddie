{
  "name": "@freddie/freddie-api-workspace-controller",
  "description": "Host workspace Remote namespace and directory-picking controller over the durable workspace registry",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/api/workspace-controller"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./remote": {
      "default": "./src/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./typert": {
      "default": "./src/typert.host.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.js"
  ],
  "license": "MIT",
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@freddie/cordis": "*",
    "@freddie/freddie-host-directory-picker": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-typert-protocol": "*",
    "@freddie/freddie-workspace": "*"
  },
  "devDependencies": {
    "@freddie/cordis": "*",
    "@freddie/freddie-host-directory-picker": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-typert-protocol": "*",
    "@freddie/freddie-workspace": "*"
  }
}
