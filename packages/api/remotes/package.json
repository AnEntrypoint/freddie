{
  "name": "@freddie/freddie-api-remotes",
  "description": "Remote BFF assembly and Host Agent/Session lookup policy",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/api/remotes"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./client": {
      "default": "./src/client/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "freddie": {
    "client": {
      "inject": [
        "@freddie/freddie-api-gateway"
      ],
      "platform": "web",
      "immediately": true,
      "external": [
        "@freddie/freddie-commands/remote",
        "@freddie/freddie-goal/remote",
        "@freddie/freddie-cordis-host-runner/remote",
        "@freddie/freddie-file-reference/remote",
        "@freddie/freddie-host-plugin-inventory/remote",
        "@freddie/freddie-message-feedback/remote",
        "@freddie/freddie-session-reference/remote"
      ]
    }
  },
  "license": "MIT",
  "files": [
    "src/*.js",
    "src/client/*.js"
  ],
  "dependencies": {
    "@freddie/freddie-typert-protocol": "*"
  },
  "peerDependencies": {
    "@freddie/freddie-agent": "*",
    "@freddie/freddie-agent-presets": "*",
    "@freddie/freddie-api-gateway": "*",
    "@freddie/freddie-commands": "*",
    "@freddie/freddie-cordis-host-runner": "*",
    "@freddie/freddie-credentials": "*",
    "@freddie/freddie-file-reference": "*",
    "@freddie/freddie-goal": "*",
    "@freddie/freddie-host-plugin-inventory": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-llm": "*",
    "@freddie/freddie-message-feedback": "*",
    "@freddie/freddie-session": "*",
    "@freddie/freddie-session-persistence": "*",
    "@freddie/freddie-session-reference": "*",
    "@freddie/freddie-settings": "*",
    "@freddie/freddie-typert-registry": "*",
    "@freddie/cordis": "*"
  },
  "devDependencies": {
    "@freddie/freddie-agent": "*",
    "@freddie/freddie-agent-presets": "*",
    "@freddie/freddie-api-gateway": "*",
    "@freddie/freddie-commands": "*",
    "@freddie/freddie-cordis-host-runner": "*",
    "@freddie/freddie-credentials": "*",
    "@freddie/freddie-file-reference": "*",
    "@freddie/freddie-goal": "*",
    "@freddie/freddie-host-plugin-inventory": "*",
    "@freddie/freddie-invariants": "*",
    "@freddie/freddie-llm": "*",
    "@freddie/freddie-message-feedback": "*",
    "@freddie/freddie-session": "*",
    "@freddie/freddie-session-persistence": "*",
    "@freddie/freddie-session-reference": "*",
    "@freddie/freddie-settings": "*",
    "@freddie/freddie-typert-registry": "*",
    "@freddie/cordis": "*"
  }
}
