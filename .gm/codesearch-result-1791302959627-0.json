alog.js","text":"    description: 'Workflow Service Definition contract. Invalid requests throw before publication; a live run is holder-owned, its result never rejects, cancellation and disposal are bounded, and disposal waits for child cleanup within that bound. Lifecycle listener failures are contained, and `workflow/end` fires exactly once as the result settles.',"},{"column":43,"line":2228,"match":"workflow","occurrence_count":1,"path":"/config/workspace/freddie/packages/extensions/tool-cordis/src/api-catalog.js","text":"        description: 'Parse and execute a workflow script.',"},{"column":12,"line":2711,"match":"workflow","occurrence_count":1,"path":"/config/workspace/freddie/packages/extensions/tool-cordis/src/api-catalog.js","text":"    name: 'workflow/agent-end',"},{"column":19,"line":2713,"match":"workflow","occurrence_count":1,"path":"/config/workspace/freddie/packages/extensions/tool-cordis/src/api-catalog.js","text":"    signature: '\\'workflow/agent-end\\'(info: WorkflowRunInfo, agent: WorkflowAgentEndInfo): void',"},{"column":119,"line":2715,"match":"workflow","occurrence_count":1,"path":"/config/workspace/freddie/packages/extensions/tool-cordis/src/api-catalog.js","text":"    description: 'One `agent()` call settled (clean result, child failure, or run cancellation). Paired with Events[\\'workflow/agent-start\\'] by `agent.seq`, exactly once per started call on every stop path — on an engine termination path (a worker killed past its grace) the end is engine-synthesized with outcome `\\'cancelled\\'`.',"},{"column":12,"line":2719,"match":"workflow","occurrence_count":1,"path":"/config/workspace/freddie/packages/extensions/tool-cordis/src/api-catalog.js","text":"    name: 'workflow/agent-start',"},{"column":19,"line":2721,"match":"workflow","occurrence_count":1,"path":"/config/workspace/freddie/packages/extensions/tool-cordis/src/api-catalog.js","text":"    signature: '\\'workflow/agent-start\\'(info: WorkflowRunInfo, agent: WorkflowAgentInfo): void',"},{"column":94,"line":2723,"match":"workflow","occurrence_count":1,"path":"/config/workspace/freddie/packages/extensions/tool-cordis/src/api-catalog.js","text":"    description: 'One `agent()` call established a published child run. Paired with Events[\\'workflow/agent-end\\'] by `agent.seq`. A call that never receives a published run from the provider emits neither event in this pair.',"},{"column":12,"line":2727,"match":"workflow","occurrence_count":1,"path":"/config/workspace/freddie/packages/extensions/tool-cordis/src/api-catalog.js","text":"    name: 'workflow/end',"},{"column":19,"line":2729,"match":"workflow","occurrence_count":1,"path":"/config/workspace/freddie/packages/extensions/tool-cordis/src/api-catalog.js","text":"    signature: '\\'workflow/end\\'(info: WorkflowRunInfo, result: WorkflowResultInfo): void',"},{"column":17,"line":2730,"match":"workflow","occurrence_count":1,"path":"/config/workspace/freddie/packages/extensions/tool-cordis/src/api-catalog.js","text":"    summary: 'A workflow run settled (any stop reason).',"},{"column":21,"line":2731,"match":"workflow","occurrence_count":2,"path":"/config/workspace/freddie/packages/extensions/tool-cordis/src/api-catalog.js","text":"    description: 'A workflow run settled (any stop reason). Fired when WorkflowRun.result resolves. Paired with Events[\\'workflow/start\\'].',"},{"column":12,"line":2735,"match":"workflow","occurrence_count":1,"path":"/config/workspace/freddie/packages/extensions/tool-cordis/src/api-catalog.js","text":"    name: 'workflow/log',"},{"column":19,"line":2737,"match":"workflow","occurrence_count":1,"path":"/config/workspace/freddie/packages/extensions/tool-cordis/src/api-catalog.js","text":"    signature: '\\'workflow/log\\'(info: WorkflowRunInfo, message: string): void',"},{"column":12,"line":2743,"match":"workflow","occurrence_count":1,"path":"/config/workspace/freddie/packages/extensions/tool-cordis/src/api-catalog.js","text":"    name: 'workflow/phase',"},{"column":19,"lin