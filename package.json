{
  "name": "freddie",
  "version": "0.0.271",
  "type": "module",
  "description": "Open JS agent harness built on pi-mono, xstate, and anentrypoint-design",
  "bin": {
    "freddie": "./bin/freddie.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./browser": {
      "browser": "./dist/browser/freddie.js",
      "default": "./src/browser/index.js"
    },
    "./plugins/*": "./plugins/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "node bin/freddie.js",
    "lint": "node scripts/lint.mjs",
    "build:browser": "vite build --config vite.browser.config.js",
    "link-local-design": "node scripts/link-local-design.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.83.0",
    "@earendil-works/pi-tui": "^0.83.0",
    "@libsql/client": "^0.17.4",
    "acptoapi": "^1.0.202",
    "anentrypoint-design": "latest",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "flatspace": "^1.0.20",
    "gm-plugkit": "^2.0.2496",
    "gm-skill": "^2.0.2496",
    "js-yaml": "^5.2.3",
    "msgpackr": "^2.0.5",
    "plugsdk": "^1.0.26",
    "vscode-languageserver": "^10.1.0",
    "vscode-languageserver-textdocument": "^1.0.12",
    "ws": "^8.21.2",
    "xstate": "^5.32.5"
  },
  "optionalDependencies": {
    "@libsql/darwin-arm64": "^0.5.29",
    "@libsql/darwin-x64": "^0.5.29",
    "@libsql/linux-arm64-gnu": "^0.5.29",
    "@libsql/linux-arm64-musl": "^0.5.29",
    "@libsql/linux-x64-gnu": "^0.5.29",
    "@libsql/linux-x64-musl": "^0.5.29",
    "@libsql/win32-x64-msvc": "^0.5.29",
    "blessed": "^0.1.81",
    "dockerode": "^5.0.1",
    "puppeteer-core": "^25.5.0",
    "ssh2": "^1.17.0",
    "undici": "^8.10.0"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "files": [
    "bin/",
    "src/",
    "plugins/",
    "skills/",
    "README.md",
    "CHANGELOG.md",
    "AGENTS.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnEntrypoint/freddie.git"
  },
  "bugs": {
    "url": "https://github.com/AnEntrypoint/freddie/issues"
  },
  "homepage": "https://github.com/AnEntrypoint/freddie#readme",
  "license": "MIT",
  "keywords": [
    "ai",
    "agent",
    "llm",
    "cli",
    "coding-agent",
    "freddie",
    "pi-mono",
    "xstate"
  ],
  "devDependencies": {
    "esbuild": "^0.28.1",
    "vite": "^8.2.0"
  }
}
