{
  "name": "freddie",
  "version": "0.0.279",
  "type": "module",
  "description": "Open JS agent harness built on pi-mono, xstate, and anentrypoint-design",
  "bin": {
    "freddie": "./bin/freddie.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./browser": {
      "browser": "./dist/browser/freddie.js",
      "default": "./src/browser/index.js"
    },
    "./plugins/*": "./plugins/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "node bin/freddie.js",
    "lint": "node scripts/lint.mjs",
    "build:browser": "vite build --config vite.browser.config.js",
    "link-local-design": "node scripts/link-local-design.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "latest",
    "@earendil-works/pi-tui": "latest",
    "@libsql/client": "latest",
    "acptoapi": "github:AnEntrypoint/acptoapi",
    "anentrypoint-design": "github:AnEntrypoint/design",
    "commander": "latest",
    "dotenv": "latest",
    "express": "latest",
    "flatspace": "latest",
    "gm-plugkit": "latest",
    "gm-skill": "latest",
    "js-yaml": "latest",
    "msgpackr": "latest",
    "plugsdk": "github:AnEntrypoint/plugsdk",
    "vscode-languageserver": "latest",
    "vscode-languageserver-textdocument": "latest",
    "ws": "latest",
    "xstate": "latest"
  },
  "optionalDependencies": {
    "@libsql/darwin-arm64": "latest",
    "@libsql/darwin-x64": "latest",
    "@libsql/linux-arm64-gnu": "latest",
    "@libsql/linux-arm64-musl": "latest",
    "@libsql/linux-x64-gnu": "latest",
    "@libsql/linux-x64-musl": "latest",
    "@libsql/win32-x64-msvc": "latest",
    "blessed": "latest",
    "dockerode": "latest",
    "puppeteer-core": "latest",
    "ssh2": "latest",
    "undici": "latest"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "files": [
    "bin/",
    "src/",
    "plugins/",
    "skills/",
    "README.md",
    "CHANGELOG.md",
    "AGENTS.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnEntrypoint/freddie.git"
  },
  "bugs": {
    "url": "https://github.com/AnEntrypoint/freddie/issues"
  },
  "homepage": "https://github.com/AnEntrypoint/freddie#readme",
  "license": "MIT",
  "keywords": [
    "ai",
    "agent",
    "llm",
    "cli",
    "coding-agent",
    "freddie",
    "pi-mono",
    "xstate"
  ],
  "devDependencies": {
    "esbuild": "latest",
    "vite": "latest"
  }
}
